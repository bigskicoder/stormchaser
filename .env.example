# --- Supabase (Postgres) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# service role key — server-only, never expose to the client bundle
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Clerk (auth — admin panel gate + optional subscriber email capture) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
# comma-separated Clerk user IDs allowed into /admin
ADMIN_USER_IDS=user_xxx

# --- Resend (alert email delivery) ---
RESEND_API_KEY=re_xxx
ALERTS_FROM_EMAIL=alerts@yourdomain.com

# --- Open-Meteo ---
# Free non-commercial tier requires no key. Set this once the product is
# monetized and you've moved to the commercial tier (see docs/DATA_SOURCES.md).
OPEN_METEO_API_KEY=
OPEN_METEO_BASE_URL=https://api.open-meteo.com

# --- NWS (api.weather.gov) — public-baseline comparison pipeline, not an
# OpenSnow integration (see ROADMAP.md). No API key; NWS requires a
# descriptive User-Agent identifying the app + a contact method instead.
NWS_USER_AGENT=powder-alert (contact@yourdomain.com)

# --- Travelpayouts (indicative fare enrichment, section 2.4) ---
TRAVELPAYOUTS_TOKEN=your-token
TRAVELPAYOUTS_MARKER=your-marker

# --- Meta / Instagram Graph API (admin-triggered social posting, section 8) ---
IG_USER_ID=your-instagram-business-account-id
IG_ACCESS_TOKEN=your-long-lived-page-access-token
# Meta periodically deprecates old Graph API versions (~2yr window) — bump
# this if calls start failing with a version-deprecated error. Also confirm
# which base domain your actual app setup uses; see lib/social/instagram.ts.
IG_GRAPH_API_VERSION=v23.0
IG_GRAPH_API_BASE_URL=https://graph.facebook.com
# Public base URL the Instagram Graph API can fetch generated graphics from
# (container creation requires a publicly reachable image_url).
PUBLIC_BASE_URL=https://your-deployed-domain.vercel.app

# --- Cron auth ---
# Vercel signs cron requests with this header automatically in production;
# set the same value here so route handlers can verify non-Vercel callers.
CRON_SECRET=generate-a-random-secret

# --- Misc ---
NODE_ENV=development
